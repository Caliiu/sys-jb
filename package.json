{
  "name": "sysjb",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sysjb/database migrate:deploy",
    "db:seed": "pnpm --filter @sysjb/database seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @sysjb/api dev",
    "dev:web": "pnpm --filter @sysjb/web dev"
  }
}
