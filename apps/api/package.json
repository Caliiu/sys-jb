    "@sysjb/database": "workspace:*",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.30",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
