        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agentToken": {
                    "type": "string",
                    "description": "Token do agente",
                    "example": "SEU_TOKEN_DE_AGENTE"
                  },
                  "secretKey": {
                    "type": "string",
                    "description": "Segredo do agente",
