                            "example": 10,
                            "description": "Total pago nessa rodada grátis."
                          }
                        }
                      },
                      "user_before_balance": {
                        "type": "float",
                        "description": "Saldo do usuário antes da transação",
                        "example": 200
                      },
                      "user_after_balance": {
                        "type": "float",
                        "description": "Saldo do usuário após a transação",
                        "example": 250
                      },
                      "created_at": {
                        "type": "string",
                        "description": "Data e hora da transação (formato ISO 8601)",
                        "example": "2023-10-01T12:34:56Z"
                      }
                    }
                  }
                }
              }
            }
          }
