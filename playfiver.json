                      },
                      "win": {
                        "type": "float",
                        "description": "Valor ganho",
                        "example": 100
                      },
                      "txn_id": {
                        "type": "string",
                        "description": "ID da transação",
                        "example": "TXN123456"
                      },
                      "txn_type": {
                        "type": "string",
                        "description": "Tipo de transação (debit_credit, credit, debit, bonus)",
                        "example": "debit_credit"
                      },
                      "buy_bonus": {
                        "type": "boolean",
