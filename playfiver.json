    "headers": {
      "X-Content-Type-Options": {
        "schema": {
          "type": "string"
        },
        "example": "nosniff"
      },
      "X-XSS-Protection": {
        "schema": {
          "type": "integer"
        },
        "example": 0
      },
      "Cache-Control": {
        "schema": {
          "type": "string"
        },
        "example": "no-cache, no-store, max-age=0, must-revalidate"
      },
      "Pragma": {
        "schema": {
          "type": "string"
        },
        "example": "no-cache"
      },
      "Expires": {
        "schema": {
          "type": "integer"
        },
        "example": 0
      },
      "X-Frame-Options": {
        "schema": {
          "type": "string"
        },
        "example": "DENY"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v2/game_launch": {
      "parameters": [],
      "post": {
        "summary": "Iniciar jogo",
        "tags": [
          "Jogos"
        ],
        "description": "Informações de como iniciar um jogo.",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "example": "application/json",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitação bem-sucedida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true,
                      "description": "Indica se a resposta foi bem-sucedida."
                    },
                    "msg": {
                      "type": "string",
                      "example": "SUCCESS",
                      "description": "Indica se a resposta foi bem-sucedida."
                    },
                    "launch_url": {
                      "type": "string",
                      "example": "https://games.playfivers.com/launch?token=SEU_TOKEN_DE_JOGO",
                      "description": "URL para iniciar o jogo."
                    },
                    "user_code": {
                      "type": "string",
                      "example": "teste0209@email.com",
                      "description": "Código do usuário em seu sistema."
                    },
                    "user_balance": {
                      "type": "float",
                      "example": 150.75,
                      "description": "Saldo do jogador."
                    },
                    "user_created": {
                      "type": "boolean",
                      "example": false,
                      "description": "Indica se o usuário foi criado durante esta solicitação."
                    },
                    "name": {
                      "type": "string",
                      "example": "Book of Golden Sands",
                      "description": "Nome do jogo."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Game_code incorreto ou corpo inválido.",
            "content": {
              "application/json": {
                "example": {
                  "status": 0,
                  "msg": "Esse game_code não existe"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno no servidor",
            "content": {
              "application/json": {
                "example": {
                  "status": 0,
                  "msg": "Error interno"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agentToken": {
                    "type": "string",
                    "description": "Token do agente",
                    "example": "SEU_TOKEN_DE_AGENTE"
                  },
                  "secretKey": {
                    "type": "string",
                    "description": "Segredo do agente",
                    "example": "SUA_CHAVE_SECRETA"
                  },
                  "user_code": {
                    "type": "string",
                    "description": "Código do usuário em seu sistema.",
                    "example": "teste0209@email.com"
                  },
                  "game_code": {
                    "type": "string",
                    "description": "Código do jogo em nosso sistema. Você pode obter a lista de jogos disponíveis através do endpoint /api/v2/games.",
                    "example": "126"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Nome do provedor em nosso sistema. Você pode obter o nome dos provedores através da lista de jogos disponíveis através do endpoint /api/v2/games ou através do nosso painel.",
                    "example": "PGSOFT"
                  },
                  "game_original": {
                    "type": "boolean",
                    "description": "Se o jogo é original ou não, você pode obter essa informação através da lista de jogos.",
                    "example": true
                  },
                  "user_balance": {
                    "type": "float",
                    "description": "Saldo do jogador atualizado.",
                    "example": 100.5
                  },
                  "user_rtp": {
                    "type": "integer",
                    "description": "RTP do usuário (Opcional).",
                    "example": 70
                  },
                  "lang": {
                    "type": "string",
                    "description": "Linguagem do jogo: pt, es, en, ja, zh, ru, th, hi.",
                    "example": "pt"
                  }
                },
                "required": [
                  "agentToken",
                  "secretKey",
                  "user_code",
                  "game_code",
                  "provider",
                  "game_original",
                  "user_balance",
                  "lang"
                ]
              }
            }
          }
        }
      }
    },
