                  },
                  "agent_code": {
                    "type": "string",
                    "description": "Código do agente",
                    "example": "AGENTE123"
                  },
                  "agent_secret": {
                    "type": "string",
                    "description": "Segredo do agente",
                    "example": "SEGREDO123"
                  },
                  "user_code": {
                    "type": "string",
