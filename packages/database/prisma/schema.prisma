// Constraints adicionais (CHECK, FKs compostas, sequence) e RLS ficam em migrations SQL.
// Ver prisma/migrations/*_security.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED

  @@map("user_status")
}

enum OperatorRole {
  MANAGER
  FINANCE
  SUPPORT

  @@map("operator_role")
}

model Tenant {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String    @unique
  domain           String    @unique
  logoUrl          String?   @map("logo_url")
  primaryColor     String    @map("primary_color")
  secondaryColor   String    @map("secondary_color")
  // Texto da barra "Indique um amigo" do app do jogador (editável pelo painel).
  inviteBarText    String    @default("Indique um amigo e ganhe bônus") @map("invite_bar_text")
  // Barra ligada: aparece no topo de todas as telas do jogador.
  inviteBarEnabled Boolean   @default(true) @map("invite_bar_enabled")
  // WhatsApp do suporte (só dígitos, DDD + número). Usado quando o jogador não tem promotor vinculado.
  supportPhone     String?   @map("support_phone")
  // Quando a logo enviada pelo painel (tenant_logos) mudou; null = sem logo enviada (vale logo_url).
  logoUpdatedAt    DateTime? @map("logo_updated_at") @db.Timestamptz(3)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  wallets              Wallet[]
  sessions             Session[]
  loginFailures        LoginFailure[]
  operators            Operator[]
  operatorSessions     OperatorSession[]
  auditLogs            AuditLog[]
  fazendinhaBets       FazendinhaBet[]
  fazendinhaBetNumbers FazendinhaBetNumber[]
  walletEntries        WalletEntry[]
  settings             TenantSettings?
  lotteryTickets       LotteryTicket[]
  lotteryTicketItems   LotteryTicketItem[]
  traditionalQuotes    TraditionalQuote[]
  fazendinhaQuotes     FazendinhaQuote[]
  commissionClosings   CommissionClosing[]
  commissionPayouts    CommissionPayout[]
  draws                Draw[]
  drawExceptions       DrawException[]
  murals               Mural[]
  muralViews           MuralView[]
  logo                 TenantLogo?
  pushSubscriptions    PushSubscription[]
  pulePrizes           PulePrize[]
  puleSettlements      PuleSettlement[]
  casinoTransactions   CasinoTransaction[]
  betCommissions       BetCommission[]
  paymentGateways      PaymentGateway[]
  pixDeposits          PixDeposit[]
  pixWithdrawals       PixWithdrawal[]
  casinoCommissions    CasinoCommissionPayout[]
  depositBonuses       DepositBonus[]

  @@map("tenants")
}

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  name                  String
  email                 String?
  phone                 String
  document              String
  avatar                String?
  birthDate             DateTime   @map("birth_date") @db.Date
  // Hash argon2id (formato PHC). Nunca sai da API.
  passwordHash          String     @map("password_hash")
  displayId             Int        @unique @default(autoincrement()) @map("display_id")
  // Código do link de convite (?convite=): 5 caracteres sem ambíguos (sem O/0/I/1), gerado pelo banco,
  // único no sistema todo e fixo (a API não altera). Ver migration invite_codes.
  inviteCode            String     @unique @default(dbgenerated("generate_invite_code()")) @map("invite_code")
  // BLOCKED: não consegue entrar e perde as sessões abertas. Só operadores alteram.
  status                UserStatus @default(ACTIVE)
  // Promotor = usuário com comissão definida (centésimos de %, 1 a 10000 = 0,01% a 100%). Null = não é promotor. Só operadores alteram.
  promoterCommissionBps Int?       @map("promoter_commission_bps")
  // Comissão de cassino do promotor (centésimos de % do GGR mensal dos indicados). 0 para quem não é promotor.
  casinoCommissionBps   Int        @default(dbgenerated("0")) @map("casino_commission_bps")
  // Promotor que indicou este usuário (pelo link de convite, só no cadastro). Nunca muda depois.
  referredByUserId      String?    @map("referred_by_user_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  wallet             Wallet?
  sessions           Session[]
  referredBy         User?                    @relation("Referrals", fields: [tenantId, referredByUserId], references: [tenantId, id], onDelete: Restrict)
  referrals          User[]                   @relation("Referrals")
  fazendinhaBets     FazendinhaBet[]
  lotteryTickets     LotteryTicket[]
  walletEntries      WalletEntry[]
  commissionPayouts  CommissionPayout[]
  muralViews         MuralView[]
  pushSubscriptions  PushSubscription[]
  pulePrizes         PulePrize[]
  puleSettlements    PuleSettlement[]
  casinoTransactions CasinoTransaction[]
  pixDeposits        PixDeposit[]
  pixWithdrawals     PixWithdrawal[]
  casinoCommissions  CasinoCommissionPayout[]
  depositBonuses     DepositBonus[]
  betCommissions     BetCommission[]          @relation("BetCommissionReferrer")
  commissionedBets   BetCommission[]          @relation("BetCommissionBettor")

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt(sort: Desc), id])
  @@index([tenantId, referredByUserId, createdAt(sort: Desc), id])
  @@index([tenantId, promoterCommissionBps])
  @@map("users")
}

// Valores em centavos (bigint). CHECKs garantem >= 0 e somas dentro de Number.MAX_SAFE_INTEGER.
model Wallet {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  balanceJb    BigInt   @default(0) @map("balance_jb")
  bonusJb      BigInt   @default(0) @map("bonus_jb")
  prizesJb     BigInt   @default(0) @map("prizes_jb")
  balanceGames BigInt   @default(0) @map("balance_games")
  bonusGames   BigInt   @default(0) @map("bonus_games")
  prizesGames  BigInt   @default(0) @map("prizes_games")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // FK composta: a carteira só pode apontar para um usuário da MESMA banca.
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@map("wallets")
}

// Sessão de cliente: token opaco; só o SHA-256 do token é persistido.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("sessions")
}

// Falhas de login recentes, para bloqueio temporário por CPF. Guarda só o hash do CPF.
model LoginFailure {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  identifierHash String   @map("identifier_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, identifierHash, createdAt])
  @@map("login_failures")
}

// Operador do painel administrativo de UMA banca (o painel é único; a banca vem do operador). Criado por script (sem cadastro pela API).
model Operator {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  // Único no sistema todo: o login do painel (admin.<domínio>) descobre a banca pelo e-mail.
  email        String       @unique
  // Hash argon2id (formato PHC). Nunca sai da API.
  passwordHash String       @map("password_hash")
  role         OperatorRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            OperatorSession[]
  auditLogs           AuditLog[]
  walletEntries       WalletEntry[]
  commissionClosings  CommissionClosing[]
  paymentGateways     PaymentGateway[]
  reviewedDeposits    PixDeposit[]             @relation("PixDepositReviewer")
  reviewedWithdrawals PixWithdrawal[]          @relation("PixWithdrawalReviewer")
  resolvedWithdrawals PixWithdrawal[]          @relation("PixWithdrawalResolver")
  casinoCommissions   CasinoCommissionPayout[]

  @@unique([tenantId, id])
  @@map("operators")
}

// Tentativas de login de operador que falharam. Sem banca: o e-mail digitado pode nem existir, e o
// controle vale antes de se saber a banca. Guarda só o HMAC do e-mail.
model OperatorLoginFailure {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifierHash String   @map("identifier_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash, createdAt])
  @@map("operator_login_failures")
}

// Sessão de operador: token opaco; só o SHA-256 do token é persistido.
model OperatorSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operator Operator @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, operatorId])
  @@map("operator_sessions")
}

// Trilha de auditoria (somente inclusão): quem fez o quê. "details" guarda nomes de campos,
// nunca valores pessoais.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operator Operator @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, targetType, targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum FazendinhaMode {
  GRUPO
  DEZENA
  CENTENA

  @@map("fazendinha_mode")
}

// Pule da Fazendinha: uma compra de palpites numa extração (data + loteria + hora), modalidade e valor.
// Criado pela API na mesma transação do débito (função fazendinha_debit); um trigger adiado recusa o commit
// de pule sem o débito correspondente. Somente inclusão.
model FazendinhaBet {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  // Número exibido no comprovante (sequence global, lacunas aceitas).
  puleNumber     Int            @unique @default(autoincrement()) @map("pule_number")
  // Gerada pelo cliente por tentativa de compra: repetir a chave devolve o mesmo pule.
  idempotencyKey String         @map("idempotency_key") @db.Uuid
  drawDate       DateTime       @map("draw_date") @db.Date
  lottery        String
  drawHour       Int            @map("draw_hour") @db.SmallInt
  // Código da extração na venda (ex.: LTTRIVO09), gravado pelo trigger a partir do cadastro.
  drawCode       String         @default(dbgenerated("''")) @map("draw_code")
  mode           FazendinhaMode
  stakeCents     Int            @map("stake_cents")
  // Prêmio de cada número pela cotação vigente na compra (a cotação pode mudar depois).
  prizeCents     Int            @map("prize_cents")
  multiplier     Int
  totalCents     BigInt         @map("total_cents")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  numbers       FazendinhaBetNumber[]
  walletEntry   WalletEntry?
  betCommission BetCommission?
  settlement    PuleSettlement?

  @@unique([tenantId, id])
  @@unique([tenantId, userId, idempotencyKey])
  // Alvo da FK composta dos números: garante que o número vendido é da mesma extração/modalidade/valor do pule.
  @@unique([tenantId, id, drawDate, lottery, drawHour, mode, stakeCents])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@index([tenantId, lottery, drawHour, drawDate])
  @@map("fazendinha_bets")
}

// Número vendido. O UNIQUE da extração/modalidade/valor impede vender o mesmo número duas vezes.
model FazendinhaBetNumber {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  betId      String         @map("bet_id") @db.Uuid
  drawDate   DateTime       @map("draw_date") @db.Date
  lottery    String
  drawHour   Int            @map("draw_hour") @db.SmallInt
  mode       FazendinhaMode
  stakeCents Int            @map("stake_cents")
  number     Int            @db.SmallInt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bet    FazendinhaBet @relation(fields: [tenantId, betId, drawDate, lottery, drawHour, mode, stakeCents], references: [tenantId, id, drawDate, lottery, drawHour, mode, stakeCents], onDelete: Restrict)

  @@unique([tenantId, drawDate, lottery, drawHour, mode, stakeCents, number])
  @@index([tenantId, betId])
  @@map("fazendinha_bet_numbers")
}

// Movimentação da carteira (somente inclusão, inclusive para a dona). Deltas em centavos por bolsa;
// negativos = débito. O banco exige, ao fim de cada transação, saldo = soma das movimentações.
// Tipos: FAZENDINHA_BET (função fazendinha_debit), MANUAL_ADJUSTMENT (função wallet_manual_adjust, com
// motivo), OPERATOR_CREDIT (crédito pelo painel, função wallet_operator_credit, com operador e motivo),
// OPENING_BALANCE (saldos anteriores ao registro, criados pelas migrations).
model WalletEntry {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  kind                     String
  balanceJbDelta           BigInt   @map("balance_jb_delta")
  prizesJbDelta            BigInt   @map("prizes_jb_delta")
  bonusJbDelta             BigInt   @default(0) @map("bonus_jb_delta")
  balanceGamesDelta        BigInt   @default(0) @map("balance_games_delta")
  // Prêmios de games (cassino): aposta tira daqui depois do saldo; prêmio entra aqui.
  prizesGamesDelta         BigInt   @default(0) @map("prizes_games_delta")
  // Motivo (obrigatório no ajuste manual e no crédito pelo painel).
  note                     String?
  // Operador que creditou pelo painel (OPERATOR_CREDIT).
  operatorId               String?  @map("operator_id") @db.Uuid
  // Chave do crédito pelo painel: repetir a mesma chave não credita de novo.
  idempotencyKey           String?  @map("idempotency_key") @db.Uuid
  // Pagamento de comissão do fechamento mensal (COMMISSION).
  commissionPayoutId       String?  @map("commission_payout_id") @db.Uuid
  // Pule de loteria: débito (LOTTERY_BET) e devolução no cancelamento (LOTTERY_REFUND), um de cada por pule.
  lotteryTicketId          String?  @map("lottery_ticket_id") @db.Uuid
  // Um débito por pule (UNIQUE): a função não debita duas vezes o mesmo pule.
  fazendinhaBetId          String?  @map("fazendinha_bet_id") @db.Uuid
  // Comissão de uma aposta: crédito na hora (COMMISSION) e estorno no cancelamento (COMMISSION_REVERSAL).
  betCommissionId          String?  @map("bet_commission_id") @db.Uuid
  // Prêmio de um pule (PRIZE): um crédito por pule premiada, na bolsa de prêmios.
  pulePrizeId              String?  @map("pule_prize_id") @db.Uuid
  // Rodada do cassino (CASINO): uma movimentação por transação do provedor.
  casinoTransactionId      String?  @map("casino_transaction_id") @db.Uuid
  // Depósito Pix confirmado (DEPOSIT): um crédito por depósito.
  pixDepositId             String?  @map("pix_deposit_id") @db.Uuid
  // Saque (WITHDRAWAL: reserva na solicitação; WITHDRAWAL_REFUND: devolução se não for pago).
  pixWithdrawalId          String?  @map("pix_withdrawal_id") @db.Uuid
  // Comissão de cassino do fechamento mensal (CASINO_COMMISSION): um crédito por pagamento.
  casinoCommissionPayoutId String?  @map("casino_commission_payout_id") @db.Uuid
  // Bônus de recarga (DEPOSIT_BONUS): um crédito por bônus, na bolsa de bônus.
  depositBonusId           String?  @map("deposit_bonus_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                   User                    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  fazendinhaBet          FazendinhaBet?          @relation(fields: [tenantId, fazendinhaBetId], references: [tenantId, id], onDelete: Restrict)
  operator               Operator?               @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Restrict)
  commissionPayout       CommissionPayout?       @relation(fields: [tenantId, commissionPayoutId], references: [tenantId, id], onDelete: Restrict)
  lotteryTicket          LotteryTicket?          @relation(fields: [tenantId, lotteryTicketId], references: [tenantId, id], onDelete: Restrict)
  betCommission          BetCommission?          @relation(fields: [tenantId, betCommissionId], references: [tenantId, id], onDelete: Restrict)
  pulePrize              PulePrize?              @relation(fields: [tenantId, pulePrizeId], references: [tenantId, id], onDelete: Restrict)
  casinoTransaction      CasinoTransaction?      @relation(fields: [tenantId, casinoTransactionId], references: [tenantId, id], onDelete: Restrict)
  pixDeposit             PixDeposit?             @relation(fields: [tenantId, pixDepositId], references: [tenantId, id], onDelete: Restrict)
  pixWithdrawal          PixWithdrawal?          @relation(fields: [tenantId, pixWithdrawalId], references: [tenantId, id], onDelete: Restrict)
  casinoCommissionPayout CasinoCommissionPayout? @relation(fields: [tenantId, casinoCommissionPayoutId], references: [tenantId, id], onDelete: Restrict)
  depositBonus           DepositBonus?           @relation(fields: [tenantId, depositBonusId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, fazendinhaBetId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, commissionPayoutId])
  @@unique([tenantId, lotteryTicketId, kind])
  @@unique([tenantId, betCommissionId, kind])
  @@unique([tenantId, pulePrizeId])
  @@unique([tenantId, casinoTransactionId])
  @@unique([tenantId, pixWithdrawalId, kind])
  @@unique([tenantId, pixDepositId])
  @@unique([tenantId, casinoCommissionPayoutId])
  @@unique([tenantId, depositBonusId])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("wallet_entries")
}

// Configurações da banca editáveis pelo painel. Uma linha por banca (criada na primeira alteração).
model TenantSettings {
  tenantId                 String   @id @map("tenant_id") @db.Uuid
  // "Indique e ganhe": % (centésimos) do valor apostado pelos indicados, pago a quem indicou no fechamento.
  referralCommissionBps    Int      @default(0) @map("referral_commission_bps")
  // Ordem e visibilidade dos blocos/cards do início do app (@sysjb/contracts, home-layout). Null = padrão.
  homeLayout               Json?    @map("home_layout")
  // Saques (Configurações > Pagamentos): ligados, mínimo e máximo por saque, quantos por dia e até quanto vai direto
  // ao gateway (acima disso, o Gerente aprova; 0 = todos passam pela aprovação). Centavos. Padrões no banco
  // (dbgenerated): o Prisma não os envia ao criar a linha, e a role de runtime não grava estas colunas.
  withdrawalsEnabled       Boolean  @default(dbgenerated("true")) @map("withdrawals_enabled")
  withdrawalMinCents       Int      @default(dbgenerated("1000")) @map("withdrawal_min_cents")
  withdrawalMaxCents       Int      @default(dbgenerated("500000")) @map("withdrawal_max_cents")
  withdrawalDailyCount     Int      @default(dbgenerated("3")) @map("withdrawal_daily_count")
  withdrawalAutoLimitCents Int      @default(dbgenerated("20000")) @map("withdrawal_auto_limit_cents")
  // Bônus de recarga de Loterias (Configurações > Personalização > Bônus): % (centésimos) e teto (centavos)
  // de cada regra, e a recarga mínima para ganhar. Gravados só por deposit_bonus_settings_save (Gerente).
  depositBonusMinCents     Int      @default(dbgenerated("1000")) @map("deposit_bonus_min_cents")
  bonusFirstBps            Int      @default(dbgenerated("0")) @map("bonus_first_bps")
  bonusFirstMaxCents       Int      @default(dbgenerated("30000")) @map("bonus_first_max_cents")
  bonusDailyBps            Int      @default(dbgenerated("0")) @map("bonus_daily_bps")
  bonusDailyMaxCents       Int      @default(dbgenerated("30000")) @map("bonus_daily_max_cents")
  bonusFederalBps          Int      @default(dbgenerated("0")) @map("bonus_federal_bps")
  bonusFederalMaxCents     Int      @default(dbgenerated("30000")) @map("bonus_federal_max_cents")
  // Regra ativa (o interruptor do painel): pausada mantém a % e o teto gravados. Ativa exige % e teto > 0.
  bonusFirstEnabled        Boolean  @default(dbgenerated("false")) @map("bonus_first_enabled")
  bonusDailyEnabled        Boolean  @default(dbgenerated("false")) @map("bonus_daily_enabled")
  bonusFederalEnabled      Boolean  @default(dbgenerated("false")) @map("bonus_federal_enabled")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

enum CommissionPayoutStatus {
  PAID
  BLOCKED
  ZERO

  @@map("commission_payout_status")
}

// Histórico do antigo fechamento mensal de comissões de Loterias/Fazendinha (indicação + promotor). Desde a
// migration bet_commissions a comissão é paga na hora da aposta (BetCommission) e nada novo entra aqui.
model CommissionClosing {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  // Primeiro dia do mês fechado (Brasília).
  month           DateTime @db.Date
  operatorId      String   @map("operator_id") @db.Uuid
  // % de indicação vigente no fechamento (a de promotor fica em cada pagamento).
  referralRateBps Int      @map("referral_rate_bps")
  totalPaidCents  BigInt   @map("total_paid_cents")
  closedAt        DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operator Operator           @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Restrict)
  payouts  CommissionPayout[]

  @@unique([tenantId, id])
  @@unique([tenantId, month])
  @@map("commission_closings")
}

// Linha do fechamento: quanto os indicados de um usuário apostaram no mês e quanto ele recebeu.
model CommissionPayout {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  closingId       String                 @map("closing_id") @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  wageredCents    BigInt                 @map("wagered_cents")
  referralRateBps Int                    @map("referral_rate_bps")
  promoterRateBps Int                    @map("promoter_rate_bps")
  amountCents     BigInt                 @map("amount_cents")
  status          CommissionPayoutStatus

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closing     CommissionClosing @relation(fields: [tenantId, closingId], references: [tenantId, id], onDelete: Restrict)
  user        User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?

  @@unique([tenantId, id])
  @@unique([closingId, userId])
  @@map("commission_payouts")
}

// Comissão de uma aposta (pule de Loterias ou da Fazendinha) a quem indicou o apostador: % de indicação da banca +
// % de promotor (se for promotor), sobre o valor pago com Saldo e Prêmios, cada parte arredondada para baixo no
// centavo. Percentuais gravados no momento da aposta. Registrada pendente na aposta (bet_commission_credit) e paga no
// Saldo na apuração do pule (bet_commission_pay); pule cancelado antes anula. Somente leitura para a API.
model BetCommission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  // Quem recebe (quem indicou o apostador).
  userId          String    @map("user_id") @db.Uuid
  bettorId        String    @map("bettor_id") @db.Uuid
  // Exatamente uma das duas apostas.
  lotteryTicketId String?   @map("lottery_ticket_id") @db.Uuid
  fazendinhaBetId String?   @map("fazendinha_bet_id") @db.Uuid
  wageredCents    BigInt    @map("wagered_cents")
  referralRateBps Int       @map("referral_rate_bps")
  promoterRateBps Int       @map("promoter_rate_bps")
  // Parte "Indique e ganhe" e parte de promotor; o crédito é a soma.
  referralCents   BigInt    @map("referral_cents")
  promoterCents   BigInt    @map("promoter_cents")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Pule cancelado: quando e quanto voltou (pode ser menos que o crédito se quem recebeu já gastou o saldo).
  reversedAt      DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedCents   BigInt?   @map("reversed_cents")
  // Pago a quem indicou na apuração do pule (null = pendente). Ver migration commission_on_settlement.
  creditedAt      DateTime? @map("credited_at") @db.Timestamptz(3)
  // Não pago: quem indicou estava bloqueado na apuração.
  forfeitedAt     DateTime? @map("forfeited_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User           @relation("BetCommissionReferrer", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  bettor        User           @relation("BetCommissionBettor", fields: [tenantId, bettorId], references: [tenantId, id], onDelete: Restrict)
  lotteryTicket LotteryTicket? @relation(fields: [tenantId, lotteryTicketId], references: [tenantId, id], onDelete: Restrict)
  fazendinhaBet FazendinhaBet? @relation(fields: [tenantId, fazendinhaBetId], references: [tenantId, id], onDelete: Restrict)
  walletEntries WalletEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, lotteryTicketId])
  @@unique([tenantId, fazendinhaBetId])
  @@index([tenantId, userId, createdAt])
  @@map("bet_commissions")
}

// Cotação do Tradicional por banca: prêmio para cada R$ 1,00 apostado. Sem linha = vale o padrão
// (@sysjb/contracts, TRADITIONAL_QUOTE_MODALITIES). 0 = modalidade desligada.
model TraditionalQuote {
  tenantId   String   @map("tenant_id") @db.Uuid
  modality   String
  prizeCents Int      @map("prize_cents")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, modality])
  @@map("traditional_quotes")
}

// Cotação da Fazendinha por banca: prêmio de cada número por modalidade e valor de aposta. Sem linha =
// padrão (valor × 22/88/880). 0 = valor não oferecido.
model FazendinhaQuote {
  tenantId   String         @map("tenant_id") @db.Uuid
  mode       FazendinhaMode
  stakeCents Int            @map("stake_cents")
  prizeCents Int            @map("prize_cents")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, mode, stakeCents])
  @@map("fazendinha_quotes")
}

// Pule de loteria (Tradicional): uma extração de uma compra. Criado pela API junto com os itens e o débito
// (função lottery_debit); um trigger adiado recusa o commit de pule sem débito. Somente inclusão.
model LotteryTicket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // Número exibido no comprovante (sequence própria, lacunas aceitas).
  puleNumber  Int       @unique @default(autoincrement()) @map("pule_number")
  // Chave da compra (a mesma em todos os pules dela): repetir a chave devolve os mesmos pules.
  purchaseKey String    @map("purchase_key") @db.Uuid
  drawDate    DateTime  @map("draw_date") @db.Date
  lottery     String
  drawHour    Int       @map("draw_hour") @db.SmallInt
  // Código da extração na venda (ex.: PT14), gravado pelo trigger a partir do cadastro.
  drawCode    String    @default(dbgenerated("''")) @map("draw_code")
  // Horário limite da extração (do cadastro de sorteios; o trigger grava o valor do cadastro).
  closesAt    DateTime  @map("closes_at") @db.Timestamptz(3)
  totalCents  BigInt    @map("total_cents")
  // Nome da tabela de cotação na compra (ex.: 800/1/8000).
  quoteTable  String    @map("quote_table")
  // Jogo: tradicional (1/7) ou tradicional_10 (1/10). Define colocações e sorteios aceitos; nunca muda.
  game        String    @default("tradicional")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Cancelado pelo jogador antes do horário limite (função lottery_cancel): aposta devolvida e comissão estornada.
  canceledAt  DateTime? @map("canceled_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  items         LotteryTicketItem[]
  walletEntries WalletEntry[]
  betCommission BetCommission?
  settlement    PuleSettlement?

  @@unique([tenantId, id])
  @@unique([tenantId, userId, purchaseKey, lottery, drawHour])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@index([tenantId, lottery, drawHour, drawDate])
  @@map("lottery_tickets")
}

// Aposta dentro do pule: modalidade + colocação + palpites + valor, com a cotação vigente na compra.
model LotteryTicketItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  ticketId           String   @map("ticket_id") @db.Uuid
  position           Int      @db.SmallInt
  modality           String
  placement          String
  guesses            String[]
  amountCents        BigInt   @map("amount_cents")
  split              String
  totalCents         BigInt   @map("total_cents")
  quoteCents         Int      @map("quote_cents")
  // Só na MILHAR E CENTENA (cuja cotação é a soma das duas): a cotação da centena na venda, que paga quem acerta só ela.
  centenaQuoteCents  Int?     @map("centena_quote_cents")
  possiblePrizeCents BigInt   @map("possible_prize_cents")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticket LotteryTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict)

  @@unique([ticketId, position])
  @@index([tenantId, ticketId])
  @@map("lottery_ticket_items")
}

// Sorteio (extração) da banca: uma lista só, que vale para Loterias e/ou Fazendinha. O pule guarda o nome e a
// hora (draw_minutes / 60); a venda é conferida contra esta tabela por trigger (dia da semana, exceções,
// ativo, jogo e horário limite). Horários em minutos desde a meia-noite, em Brasília.
model Draw {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  // Grupo da tela (ex.: RIO/FEDERAL).
  groupName        String   @map("group_name")
  // Nome no pule e na tela (ex.: LT PT RIO 09HS). Único na banca.
  name             String
  // Código curto dos relatórios (ex.: PT14). Único na banca; vazio no cadastro = gerado do nome e da hora.
  code             String   @default("")
  drawMinutes      Int      @map("draw_minutes") @db.SmallInt
  // Horário máximo de venda (<= horário do sorteio).
  closesMinutes    Int      @map("closes_minutes") @db.SmallInt
  // Dias da semana em que corre (0 = domingo … 6 = sábado).
  weekdays         Int[]    @db.SmallInt
  lotteries        Boolean  @default(true)
  // Vale para a Tradicional 1/10 (loterias oficiais de 10 prêmios).
  lotteries10      Boolean  @default(false) @map("lotteries_10")
  fazendinha       Boolean  @default(true)
  // Resultado do provedor que vale para o sorteio (sigla + extração do provedor, que pode ser outra hora):
  // os dois juntos ou nenhum (sem ligação = sem resultado na tela do jogador).
  resultLottery    String?  @map("result_lottery")
  resultExtraction Int?     @map("result_extraction") @db.SmallInt
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exceptions DrawException[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("draws")
}

// Exceção de data: CANCEL (feriado; sem sorteio = todos os sorteios do dia) ou EXTRA (o sorteio corre num dia
// fora da semana dele). Um trigger recusa exceções que deixariam apostas vendidas sem sorteio.
model DrawException {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  drawId    String?  @map("draw_id") @db.Uuid
  kind      String
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  draw   Draw?  @relation(fields: [tenantId, drawId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, date])
  @@map("draw_exceptions")
}

// Mural: aviso com imagem mostrado ao jogador ao abrir o app, dentro da vigência (dias de Brasília,
// inclusivos). A imagem fica no próprio banco (PNG/JPEG/WebP até 3 MB, conferidos por CHECK).
model Mural {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  // ONCE (cada jogador vê uma vez, registrado em mural_views) ou ALWAYS (a cada abertura do app).
  displayMode String   @map("display_mode")
  image       Bytes
  imageType   String   @map("image_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  views  MuralView[]

  @@unique([tenantId, id])
  @@index([tenantId, endsOn])
  @@map("murals")
}

// Jogador que já viu o mural (vale para "Apenas uma vez"). Um registro por mural e jogador.
model MuralView {
  tenantId String   @map("tenant_id") @db.Uuid
  muralId  String   @map("mural_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  seenAt   DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mural  Mural  @relation(fields: [tenantId, muralId], references: [tenantId, id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@id([muralId, userId])
  @@index([tenantId, userId])
  @@map("mural_views")
}

// Pule premiada: um registro por pule (Loterias ou Fazendinha), gravado pela apuração de prêmios (funções
// lottery_settle / fazendinha_settle), na mesma transação do crédito na carteira (movimentação PRIZE). Guarda o sorteio e
// o apostado como na venda, para a consulta do painel não depender dos pules. Somente inclusão; a API só lê.
model PulePrize {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // lotteries ou fazendinha (cada jogo tem a sua numeração de pule).
  game       String
  puleNumber Int      @map("pule_number")
  drawDate   DateTime @map("draw_date") @db.Date
  // Nome, hora e código do sorteio na venda.
  lottery    String
  drawHour   Int      @map("draw_hour") @db.SmallInt
  drawCode   String   @default("") @map("draw_code")
  stakeCents BigInt   @map("stake_cents")
  prizeCents BigInt   @map("prize_cents")
  settledAt  DateTime @default(now()) @map("settled_at") @db.Timestamptz(3)
  // Itens premiados: [{ position, guesses, prizeCents }] (position = ordem do item no pule; a soma é o prêmio).
  // Null só em registros antigos ou gravados à mão.
  items      Json?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, game, puleNumber])
  @@index([tenantId, drawDate])
  @@index([tenantId, userId, drawDate])
  @@map("pule_prizes")
}

// Apuração de um pule (premiado ou não): o resultado e a revisão conferidos e o prêmio pago (0 = não premiado). Gravada
// uma vez, pelas funções de apuração, depois da carência do resultado. Se o provedor corrige o resultado depois disso, o
// pago não muda: a conferência com a revisão nova fica em checked_* e a diferença vira aviso para o operador.
model PuleSettlement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  game              String
  puleNumber        Int      @map("pule_number")
  // Exatamente um dos dois, conforme o jogo.
  lotteryTicketId   String?  @map("lottery_ticket_id") @db.Uuid
  fazendinhaBetId   String?  @map("fazendinha_bet_id") @db.Uuid
  drawDate          DateTime @map("draw_date") @db.Date
  resultId          String   @map("result_id") @db.Uuid
  settledRevision   Int      @map("settled_revision")
  prizeCents        BigInt   @map("prize_cents")
  settledAt         DateTime @default(now()) @map("settled_at") @db.Timestamptz(3)
  // Última revisão do resultado conferida e o prêmio por ela (igual ao pago enquanto não houver correção).
  checkedRevision   Int      @map("checked_revision")
  checkedPrizeCents BigInt   @map("checked_prize_cents")
  checkedAt         DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  lotteryTicket LotteryTicket? @relation(fields: [tenantId, lotteryTicketId], references: [tenantId, id], onDelete: Restrict)
  fazendinhaBet FazendinhaBet? @relation(fields: [tenantId, fazendinhaBetId], references: [tenantId, id], onDelete: Restrict)
  result        LotteryResult  @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@unique([tenantId, game, puleNumber])
  @@unique([tenantId, lotteryTicketId])
  @@unique([tenantId, fazendinhaBetId])
  @@index([tenantId, drawDate])
  @@index([resultId])
  @@map("pule_settlements")
}

// Aparelho do jogador inscrito nas notificações (Web Push). Um por banca e endpoint: o mesmo aparelho que entra com
// outra conta passa a ser dela. Inscrição recusada pelo serviço de push (expirada) é apagada no envio.
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // Endereço do serviço de push (HTTPS de um serviço conhecido, conferido pela API).
  endpoint   String
  // Chave pública P-256 e segredo do aparelho (base64url), usados para cifrar o conteúdo.
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Última vez que o app confirmou a inscrição (a cada abertura com a conta).
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, endpoint])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// Logo enviada pelo painel (PNG/JPEG/WebP até 1 MB, conferidos por CHECK). Uma por banca.
model TenantLogo {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  image     Bytes
  imageType String   @map("image_type")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_logos")
}

// Contador de requisições por janela fixa (rate limiting da API). Sem banca: vale antes de haver sessão.
// A chave nunca traz IP em texto (só HMAC). Linhas vencidas são apagadas pela API.
model RateLimitCounter {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hits        Int      @default(1)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// Resultado de uma extração, recebido do provedor (webhook ou consulta). Vale para todas as bancas (sem tenant):
// um por data (Brasília) + sigla da loteria + extração. A API só grava os campos do resultado; a troca por um
// resultado diferente (correção do provedor) guarda a versão anterior em lottery_result_revisions (trigger).
model LotteryResult {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drawDate       DateTime @map("draw_date") @db.Date
  // Sigla do provedor (ex.: rj).
  lottery        String
  // Hora do sorteio (0–23).
  extraction     Int      @db.SmallInt
  // Números do 1º prêmio em diante (5 a 10; 4 dígitos, ou 5 na Federal).
  prizes         String[]
  // Campos calculados pelo provedor (só dígitos), quando informados.
  sumValue       String?  @map("sum_value")
  multiplication String?
  skipped        String?
  super5         String?
  // WEBHOOK ou CONSULTA: por onde chegou a versão atual.
  source         String
  // 1 na primeira versão; o trigger soma 1 a cada correção.
  revision       Int      @default(1)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  revisions   LotteryResultRevision[]
  settlements PuleSettlement[]

  @@unique([drawDate, lottery, extraction])
  // Histórico de uma loteria/extração (Atrasados), do dia mais recente para trás.
  @@index([lottery, extraction, drawDate(sort: Desc)])
  @@map("lottery_results")
}

// Versão substituída de um resultado (somente inclusão, gravada pelo trigger do banco).
model LotteryResultRevision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultId       String   @map("result_id") @db.Uuid
  revision       Int
  prizes         String[]
  sumValue       String?  @map("sum_value")
  multiplication String?
  skipped        String?
  super5         String?
  source         String
  // Quando a versão substituída tinha sido recebida.
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)
  replacedAt     DateTime @default(now()) @map("replaced_at") @db.Timestamptz(3)

  result LotteryResult @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@unique([resultId, revision])
  @@map("lottery_result_revisions")
}

// Atrasados de grupo na cabeça (API de atrasados da Loteria Integrada): cache por loteria/extração do provedor,
// global (sem banca). A API busca quando o jogador pede e o cache venceu (resultado novo ou prazo).
model OverdueSnapshot {
  // Sigla e extração do provedor (as do resultado ligado ao sorteio).
  lottery       String
  extraction    Int      @db.SmallInt
  // Último dia de saída de cada grupo (índice 0 = grupo 1), YYYY-MM-DD; '' = nunca saiu no histórico do provedor.
  lastDates     String[] @map("last_dates")
  // Data de referência informada pelo provedor.
  referenceDate DateTime @map("reference_date") @db.Date
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@id([lottery, extraction])
  @@map("overdue_snapshots")
}

// Consulta feita à API de resultados do provedor (somente inclusão). Serve para não repetir consulta recente
// (espera entre consultas iguais) e para contar o uso da cota mensal do contrato. Sem banca, como os resultados.
model ResultConsultation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Sempre do banco (a role de runtime não informa).
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)
  drawDate    DateTime @map("draw_date") @db.Date
  lottery     String
  // Null = todas as extrações do dia.
  extraction  Int?     @db.SmallInt
  // OK (200), EMPTY (404: nenhum resultado) ou ERROR.
  status      String
  // Status HTTP da última resposta; null = sem resposta (rede).
  httpStatus  Int?     @map("http_status") @db.SmallInt
  // Respostas HTTP recebidas (novas tentativas incluídas): o que a cota do provedor conta.
  responses   Int      @db.SmallInt
  // Itens devolvidos pelo provedor.
  items       Int      @default(0)

  @@index([requestedAt])
  @@index([drawDate, lottery, requestedAt(sort: Desc)])
  @@map("result_consultations")
}

// Previsão do dia de um signo, da API de horóscopo do provedor (Loteria Integrada): cache diário, global (sem banca).
// A API busca uma vez por dia (os 12 signos numa requisição); o jogador só lê daqui.
model HoroscopeReading {
  // Data da previsão (Brasília), a "data_referencia" do provedor.
  referenceDate DateTime @map("reference_date") @db.Date
  // aries, touro, gemeos, cancer, leao, virgem, libra, escorpiao, sagitario, capricornio, aquario, peixes.
  sign          String
  text          String
  // Dezenas da sorte ("04"…), na ordem do provedor.
  tens          String[]
  colors        String[]
  // Quando a versão atual chegou (a busca seguinte do mesmo dia pode trazer uma correção).
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@id([referenceDate, sign])
  @@map("horoscope_readings")
}

// Jogo do cassino (catálogo do provedor PlayFivers), global: sincronizado pela API a partir de /api/v2/games. O id curto
// vai no endereço da tela do jogo. Jogo que sai do catálogo fica inativo (nunca é apagado: as rodadas apontam pelo código).
model CasinoGame {
  id       Int      @id @default(autoincrement())
  // Provedor e código do jogo no PlayFivers (o par é único).
  provider String
  gameCode String   @map("game_code")
  name     String
  imageUrl String?  @map("image_url")
  // "Original" do provedor (vai no lançamento do jogo).
  original Boolean  @default(false)
  active   Boolean  @default(true)
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@unique([provider, gameCode])
  @@index([active, provider, name])
  @@map("casino_games")
}

// Rodada (transação) do cassino recebida do provedor: aposta e prêmio aplicados na carteira de games, uma vez só por
// txn_id. Gravada só pela função casino_apply_transaction, junto com a movimentação CASINO. Somente inclusão.
model CasinoTransaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  // Id da transação no provedor (único: reenvio da mesma transação não aplica de novo).
  txnId        String   @unique @map("txn_id")
  roundId      String?  @map("round_id")
  provider     String
  gameCode     String   @map("game_code")
  // debit_credit, debit, credit ou bonus.
  txnType      String   @map("txn_type")
  betCents     BigInt   @map("bet_cents")
  winCents     BigInt   @map("win_cents")
  // Disponível Games depois da transação.
  balanceAfter BigInt   @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("casino_transactions")
}

// Gateway de pagamento da banca (Configurações > Pagamentos). As credenciais chegam cifradas pela API (AES-256-GCM com
// PAYMENTS_SECRET_KEY): o banco nunca vê o texto. No máximo um ativo por banca (é por ele que saem as cobranças).
// Gravado só pelas funções payment_gateway_* (o banco confere de novo que quem altera é Gerente ativo da banca).
model PaymentGateway {
  tenantId        String   @map("tenant_id") @db.Uuid
  // Gateway (@sysjb/contracts, PAYMENT_GATEWAYS), ex.: MISTICPAY.
  gateway         String
  // iv (12 bytes) + tag (16) + texto cifrado do JSON das credenciais.
  credentials     Bytes
  // Pista para o painel reconhecer a credencial sem mostrá-la (ex.: "pk_…ab12").
  credentialsHint String   @map("credentials_hint")
  active          Boolean  @default(false)
  // Operador que gravou por último.
  updatedBy       String   @map("updated_by") @db.Uuid
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operator Operator @relation(fields: [tenantId, updatedBy], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, gateway])
  @@map("payment_gateways")
}

// Depósito (recarga) via Pix: a cobrança criada no gateway ativo da banca. O nosso id vai como identificador da
// transação no gateway. Só a função pix_deposit_confirm marca como pago (uma vez, conferindo o valor) e credita a
// carteira na mesma transação; mudanças de situação só pelas funções pix_deposit_*.
model PixDeposit {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  // Gateway que gerou a cobrança (o pagamento é conferido nele, mesmo que a banca troque o ativo depois).
  gateway               String
  // LOTTERIES (saldo de loterias) ou GAMES (saldo de games).
  destination           String
  amountCents           BigInt    @map("amount_cents")
  // PENDING, PAID, EXPIRED, CANCELED, REVIEW (pago, mas sem conferência do titular: o Gerente decide) ou REJECTED.
  status                String    @default("PENDING")
  // Quem pagou, informado pelo aviso do gateway (CPF/CNPJ só dígitos e nome). Só credita sozinho se for o jogador.
  payerDocument         String?   @map("payer_document")
  payerName             String?   @map("payer_name")
  // Quando o gateway confirmou o pagamento pela primeira vez (prazo para o aviso com o pagador chegar).
  paymentSeenAt         DateTime? @map("payment_seen_at") @db.Timestamptz(3)
  // Por que está em análise: PAYER_MISMATCH (outro titular) ou PAYER_UNKNOWN (o aviso com o pagador não chegou).
  reviewReason          String?   @map("review_reason")
  // Gerente que liberou ou recusou o depósito em análise, e quando.
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz(3)
  // Id da cobrança no gateway.
  providerTransactionId String?   @map("provider_transaction_id")
  // BR Code (copia e cola) da cobrança.
  pixCode               String?   @map("pix_code")
  // Prazo mostrado ao jogador para pagar (pagamento depois disso ainda é creditado).
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  // Última consulta ao gateway (espaça as consultas da tela e da rodada automática).
  lastCheckedAt         DateTime? @map("last_checked_at") @db.Timestamptz(3)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  reviewer    Operator?     @relation("PixDepositReviewer", fields: [tenantId, reviewedBy], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?
  bonus       DepositBonus?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("pix_deposits")
}

model PixWithdrawal {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  // Clique duplo / reenvio da tela: a mesma chave devolve o mesmo saque.
  idempotencyKey        String    @map("idempotency_key") @db.Uuid
  amountCents           BigInt    @map("amount_cents")
  // De onde saiu (reservado na solicitação): prêmios das loterias e prêmios de games (cassino).
  fromPrizesJbCents     BigInt    @map("from_prizes_jb_cents")
  fromPrizesGamesCents  BigInt    @map("from_prizes_games_cents")
  // CPF, EMAIL, PHONE ou RANDOM; a chave normalizada (CPF e celular só dígitos; e-mail e aleatória em minúsculas).
  keyType               String    @map("key_type")
  keyValue              String    @map("key_value")
  // REVIEW (aguarda o Gerente), QUEUED (aprovado, a enviar), SENDING (enviando ao gateway), PROCESSING (no gateway),
  // PAID, FAILED (o gateway não pagou: devolvido), REJECTED (recusado pelo Gerente: devolvido), CANCELED (pelo
  // jogador, em análise: devolvido).
  status                String
  // Gateway que recebeu o envio (definido ao enviar).
  gateway               String?
  providerTransactionId String?   @map("provider_transaction_id")
  // Por que voltou para análise ou falhou (código curto, sem dados do pedido).
  failureReason         String?   @map("failure_reason")
  // Motivo da recusa digitado pelo Gerente (mostrado ao jogador).
  decisionNote          String?   @map("decision_note")
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz(3)
  // Conclusão manual de um envio sem resposta (o Gerente conferiu no gateway).
  resolvedBy            String?   @map("resolved_by") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(3)
  // Quem recebeu, segundo o gateway (conferência do titular depois do pagamento).
  beneficiaryDocument   String?   @map("beneficiary_document")
  beneficiaryName       String?   @map("beneficiary_name")
  sendStartedAt         DateTime? @map("send_started_at") @db.Timestamptz(3)
  lastCheckedAt         DateTime? @map("last_checked_at") @db.Timestamptz(3)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  reviewer      Operator?     @relation("PixWithdrawalReviewer", fields: [tenantId, reviewedBy], references: [tenantId, id], onDelete: Restrict)
  resolver      Operator?     @relation("PixWithdrawalResolver", fields: [tenantId, resolvedBy], references: [tenantId, id], onDelete: Restrict)
  walletEntries WalletEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("pix_withdrawals")
}

// Pagamento do fechamento cassino de um mês a um promotor: a % de cassino dele sobre o GGR (turnover − payout) dos
// indicados no mês (Brasília), creditada no saldo de saque (prêmios das loterias). Um por promotor e mês; valores e % gravados no pagamento. Gravado só
// pela função casino_commission_pay (Gerente, mês encerrado). Somente inclusão.
model CasinoCommissionPayout {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  // Primeiro dia do mês pago (Brasília).
  month         DateTime @db.Date
  // Promotor que recebeu.
  userId        String   @map("user_id") @db.Uuid
  operatorId    String   @map("operator_id") @db.Uuid
  turnoverCents BigInt   @map("turnover_cents")
  payoutCents   BigInt   @map("payout_cents")
  ggrCents      BigInt   @map("ggr_cents")
  rateBps       Int      @map("rate_bps")
  amountCents   BigInt   @map("amount_cents")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  operator    Operator     @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, month, userId])
  @@map("casino_commission_payouts")
}

// Bônus de recarga de Loterias concedido: um por recarga, só o de maior valor entre as regras que valem (primeira
// recarga da conta, primeira do dia, primeira do dia em dia de Federal). % e teto gravados na concessão. Creditado na
// bolsa de bônus (só aposta em Loterias e Fazendinha; nunca sacável) na mesma transação da recarga, pela função
// deposit_bonus_grant. Somente inclusão.
model DepositBonus {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  pixDepositId String   @map("pix_deposit_id") @db.Uuid
  // FIRST_DEPOSIT, DAILY ou FEDERAL.
  rule         String
  depositCents BigInt   @map("deposit_cents")
  rateBps      Int      @map("rate_bps")
  maxCents     Int      @map("max_cents")
  amountCents  BigInt   @map("amount_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  pixDeposit  PixDeposit   @relation(fields: [tenantId, pixDepositId], references: [tenantId, id], onDelete: Restrict)
  walletEntry WalletEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, pixDepositId])
  @@index([tenantId, createdAt])
  @@map("deposit_bonuses")
}
