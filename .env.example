# Copie para .env com `pnpm setup:env` (gera valores aleatórios para cada "change-me-*")
# ou manualmente. Nunca commite o .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
# Dona das tabelas; usada somente por migrations, seed e setup dos testes.
SYSJB_MIGRATOR_PASSWORD=change-me-migrator-password
# Usada pela API em runtime: sem superuser, sem BYPASSRLS, não é dona das tabelas.
SYSJB_APP_PASSWORD=change-me-app-password

DATABASE_MIGRATOR_URL=postgresql://sysjb_migrator:change-me-migrator-password@127.0.0.1:5433/sysjb
DATABASE_URL=postgresql://sysjb_app:change-me-app-password@127.0.0.1:5433/sysjb

# Banco separado usado pelos testes de integração (recriado a cada execução).
TEST_DATABASE_MIGRATOR_URL=postgresql://sysjb_migrator:change-me-migrator-password@127.0.0.1:5433/sysjb_test
TEST_DATABASE_URL=postgresql://sysjb_app:change-me-app-password@127.0.0.1:5433/sysjb_test

# --- API (NestJS) ---
API_HOST=127.0.0.1
API_PORT=4000
# false = ignora X-Forwarded-Host. Só habilite atrás de um proxy confiável (ex.: "loopback").
API_TRUST_PROXY=false
DB_POOL_MAX=10
# Credencial de serviço por banca: <slug>=<chave>, separadas por vírgula (mín. 32 caracteres).
TENANT_SERVICE_KEYS=aurora=change-me-aurora-service-key,boreal=change-me-boreal-service-key

# --- Web (Next.js, somente servidor) ---
WEB_API_URL=http://127.0.0.1:4000
# Mesmas chaves, indexadas pelo hostname da banca. Nunca use prefixo NEXT_PUBLIC_.
WEB_SERVICE_KEYS=aurora.localhost=change-me-aurora-service-key,boreal.localhost=change-me-boreal-service-key
