# Copie para .env com `pnpm setup:env` (gera valores aleatórios para cada "change-me-*")
# ou manualmente. Nunca commite o .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
# Dona das tabelas; usada somente por migrations, seed e setup dos testes.
SYSJB_MIGRATOR_PASSWORD=change-me-migrator-password
# Usada pela API em runtime: sem superuser, sem BYPASSRLS, não é dona das tabelas.
SYSJB_APP_PASSWORD=change-me-app-password

DATABASE_MIGRATOR_URL=postgresql://sysjb_migrator:change-me-migrator-password@127.0.0.1:5433/sysjb
DATABASE_URL=postgresql://sysjb_app:change-me-app-password@127.0.0.1:5433/sysjb

# Banco separado usado pelos testes de integração (recriado a cada execução).
TEST_DATABASE_MIGRATOR_URL=postgresql://sysjb_migrator:change-me-migrator-password@127.0.0.1:5433/sysjb_test
TEST_DATABASE_URL=postgresql://sysjb_app:change-me-app-password@127.0.0.1:5433/sysjb_test

# --- API (NestJS) ---
API_HOST=127.0.0.1
API_PORT=4000
# false = ignora X-Forwarded-Host. Só habilite atrás de um proxy confiável (ex.: "loopback").
API_TRUST_PROXY=false
DB_POOL_MAX=10
# Credencial de serviço por banca: <slug>=<chave>, separadas por vírgula (mín. 32 caracteres).
TENANT_SERVICE_KEYS=trevo=change-me-trevo-service-key,aurora=change-me-aurora-service-key,boreal=change-me-boreal-service-key
# Credencial do painel administrativo único (admin.<domínio>), só do servidor web (mín. 32 caracteres, diferente
# das chaves das bancas). Vazia = painel desativado.
ADMIN_SERVICE_KEY=change-me-admin-service-key
# Chave HMAC usada para pseudonimizar o CPF no bloqueio de tentativas de login e o IP no limite de
# requisições (mín. 32 caracteres).
AUTH_SECRET=change-me-auth-secret
# Limite de requisições (429 + Retry-After). Formato "limite/segundos", várias janelas separadas por vírgula.
# Os valores abaixo são os padrões; apague a linha para usá-lo ou troque o número.
RATE_LIMIT_ENABLED=true
# Login de jogador e de operador, por IP (além do bloqueio de 5 falhas por CPF/e-mail).
RATE_LIMIT_LOGIN_IP=20/60,100/3600
# Cadastro de jogador, por IP.
RATE_LIMIT_SIGNUP_IP=10/3600,30/86400
# Qualquer rota, por IP (generoso: redes móveis compartilham IP).
RATE_LIMIT_REQUESTS_IP=600/60
# Por jogador logado: gravações (compras, perfil…) e consultas.
RATE_LIMIT_USER_WRITE=30/60
RATE_LIMIT_USER_READ=180/60
# Por operador do painel: alterações e consultas.
RATE_LIMIT_OPERATOR_WRITE=60/60
RATE_LIMIT_OPERATOR_READ=300/60

# --- Web (Next.js, somente servidor) ---
WEB_API_URL=http://127.0.0.1:4000
# Mesmas chaves, indexadas pelo hostname da banca (e o hostname do painel, com a ADMIN_SERVICE_KEY).
# Nunca use prefixo NEXT_PUBLIC_.
WEB_SERVICE_KEYS=trevo.localhost=change-me-trevo-service-key,aurora.localhost=change-me-aurora-service-key,boreal.localhost=change-me-boreal-service-key,admin.localhost=change-me-admin-service-key
# Hostname do painel administrativo (padrão: admin.localhost). Em produção, ex.: admin.seudominio.com.br
WEB_ADMIN_HOSTNAME=admin.localhost
# Proxies confiáveis na frente do web (nginx, balanceador, CDN), cada um acrescentando ao X-Forwarded-For.
# O IP do visitante (limite por IP da API) é o N-ésimo a partir do fim. 1 = só um nginx. 0 = não informa IP.
WEB_TRUSTED_PROXY_HOPS=1
